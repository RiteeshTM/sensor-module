# Copy to .env and fill in what you need. Every variable is optional -
# with none of them set, the app runs fully locally on the physics engine.

# --- Analysis engine ---------------------------------------------------------
# Free Google AI Studio key (https://aistudio.google.com/apikey).
# When set, analysis uses gemini-2.5-flash instead of the local heuristic.
GEMINI_API_KEY=

# GCP project used for Vertex AI and Firebase. Only relevant in cloud mode.
GOOGLE_CLOUD_PROJECT_ID=deepfake-detector-494710
GEMINI_LOCATION=global

# Landmark frames / characters embedded in the Gemini prompt.
GEMINI_MAX_FRAMES=240
GEMINI_MAX_TEXT_CHARS=20000

# --- Server ------------------------------------------------------------------
# Port for `python server.py`. Cloud Run sets this automatically.
PORT=8000

# Maximum accepted upload size in bytes (default 50 MB).
MAX_UPLOAD_BYTES=52428800

# Extra CORS origins, comma separated (localhost origins are always allowed).
ALLOWED_ORIGINS=

# Path to the MediaPipe model. Downloaded automatically when missing.
FACE_LANDMARKER_MODEL=face_landmarker.task

# --- Firebase (cloud mode only) ----------------------------------------------
# Service account key path. Omit to use `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_STORAGE_BUCKET=
